{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Riot",
  "mainBinaryName": "Riot",
  "version": "0.1.5",
  "identifier": "dev.riot.desktop",

  "build": {
    "beforeDevCommand": "node scripts/stage-kernel.mjs debug && pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/stage-kernel.mjs release && node scripts/stage-browser.mjs && pnpm build",
    "frontendDist": "../dist"
  },

  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Riot",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtocol --enable-smooth-scrolling",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true,
        "transparent": true,
        "theme": "Dark",
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; media-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost data: blob:",
      "dangerousDisableAssetCspModification": ["style-src"],
      "capabilities": ["default"]
    }
  },

  "bundle": {
    "active": true,
    // dmg 依赖 .app（bundler 会先造再清），不必、也不该单独列 "app"：
    // tauri-action 会把裸 .app 打成 .app.tar.gz 再上传，体积跟 dmg 差不多，
    // 官网和设置页都只认 dmg / setup.exe，这份资产没人下，上传却常因
    // GitHub 资产接口抖动失败（"other side closed"），白浪费一次重试。
    "targets": ["dmg", "nsis"],
    "externalBin": ["binaries/riot-kernel"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "macOS": {
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
